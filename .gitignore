# Rust build output
/target/
src-tauri/target/

# Frontend dependencies and build output
node_modules/
dist/
*.tsbuildinfo
vite.config.js
vite.config.d.ts

# Tauri generated schemas
src-tauri/gen/

# App icons are generated from src-tauri/icons/icon.svg during the build
# (see the CI workflow); only the SVG source is kept in the repository.
src-tauri/icons/*
!src-tauri/icons/icon.svg

# DeACT portable runtime data (created beside DeACT.exe at first launch).
# Never commit local databases, logs, caches, backups or credentials.
/data/
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite-wal
*.sqlite-shm

# Logs
*.log
/logs/

# Local sensitive configuration and authentication material.
# Real API keys, Telegram sessions and other credentials must never be committed.
*secret*.toml
*credentials*.toml
*.session
*.key
*.pem

# Local temporary files
*.tmp
*.bak
*.orig
.DS_Store
Thumbs.db
